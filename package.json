{
  "name": "@windi-ui/monorepo",
  "version": "0.0.1-beta",
  "type": "module",
  "private": false,
  "description": "Build Accessible Apps 10x faster",
  "scripts": {
    "docs:dev": "vitepress dev docs/docs",
    "docs:build": "vitepress build docs/docs",
    "docs:preview": "vitepress preview docs/docs",
    "build": "rimraf packages/*/{dist,es,lib} && nr -r -F \"./packages/windi\" build",
    "play": "run-s build play:run",
    "play:run": "run-p dev play:dev",
    "play:dev": "npm -C playground run dev",
    "play:build": "npm -C playground run build",
    "lint": "eslint .",
    "lint:fix": "nr lint --fix",
    "clean": "rimraf packages/*/{dist,es,lib}",
    "example": "pnpm --filter @windi-ui/example",
    "playground": "pnpm --filter @windi-ui/playground",
    "test": "vitest",
    "test:update": "vitest -u",
    "test:coverage": "vitest --coverage",
    "windi-ui": "pnpm --filter windi-vue",
    "postinstall": "npx simple-git-hooks",
    "major": "taze minor -wIr"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@eslint/js": "^9.11.1",
    "@iconify-json/carbon": "^1.2.1",
    "@iconify-json/fluent-emoji": "^1.2.0",
    "@iconify-json/logos": "^1.2.1",
    "@iconify/vue": "^4.1.2",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^2.1.1",
    "@vitest/ui": "^2.1.1",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.1.0",
    "autoprefixer": "^10.4.20",
    "bumpp": "^9.6.1",
    "eslint": "8.45.0",
    "eslint-plugin-vue": "^9.28.0",
    "flexsearch": "^0.7.43",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "postcss-prefix-selector": "^1.16.1",
    "rimraf": "^5.0.10",
    "sass": "^1.79.4",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.13",
    "taze": "^0.17.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "unocss": "^0.63.1",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.3",
    "vitepress": "^1.3.4",
    "vitest": "^2.1.1",
    "vue": "^3.5.10",
    "vue-tsc": "^2.1.6"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "search-insights"
      ]
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md}": [
      "pnpm lint:fix"
    ]
  },
  "dependencies": {
    "vitepress-plugin-group-icons": "^1.2.4"
  }
}
